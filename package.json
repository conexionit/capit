{
  "name": "capit",
  "productName": "CAPIT",
  "version": "1.0.0",
  "description": "Conexion IT - Capacitaciones (CAPIT): grabador y editor de manuales/tutoriales para SAP GUI, Fiori y apps web",
  "main": "src/main/main.js",
  "author": "Conexion IT",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "node scripts/start.js",
    "dist": "node scripts/dist.js"
  },
  "dependencies": {
    "docx": "^9.0.2",
    "fabric": "^6.4.3",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "jspdf": "^2.5.2",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "electron": "^32.1.2",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.conexionit.capit",
    "productName": "CAPIT",
    "copyright": "Copyright (c) 2026 Conexion IT",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CAPIT"
    }
  }
}
